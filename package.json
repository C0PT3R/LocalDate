{
  "name": "@c0pt3r/local-date",
  "version": "1.0.0",
  "description": "An immutable, timezone-free Gregorian calendar date for TypeScript and JavaScript.",
  "author": "C0PT3R",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/C0PT3R/LocalDate.git"
  },
  "bugs": {
    "url": "https://github.com/C0PT3R/LocalDate/issues"
  },
  "homepage": "https://github.com/C0PT3R/LocalDate#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "npm run test && npm pack --dry-run",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  },
  "keywords": [
    "date",
    "localdate",
    "typescript",
    "calendar",
    "immutable",
    "gregorian"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
