{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": "src",
    "outDir": "dist",

    "declaration": true,
    "declarationMap": true,

    "strict": true,
    "sourceMap": true,

    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "src"
  ]
}